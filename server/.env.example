# VisionAid Smart Glasses — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Cloud AI / Gemini API (OPTIONAL!) ──────────────────────────────────
# Do you need an API key? NO for core offline operation!
# The offline open-source models (YOLO, Depth Anything, EasyOCR, Piper TTS,
# faster-whisper) work 100% offline without any API keys or internet!
#
# Only set this if you want rich conversational scene understanding:
# Get a free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Device Security & Anti-Hacking ─────────────────────────────────────
# Shared secret pairing token between glasses and companion device.
# Prevents unauthorized smartphones or nearby attackers from eavesdropping
# on your video stream or injecting malicious commands.
VISIONAID_PAIRING_TOKEN=visionaid-secure-pair-token
ENCRYPT_LOCAL_STORAGE=true

# ── BLE Configuration ──────────────────────────────────────────────────
# These match the UUIDs in the ESP32 firmware (ble_comm.cpp)
BLE_SERVICE_UUID=4fafc201-1fb5-459e-8fcc-c5c9c331914b
BLE_TX_CHAR_UUID=beb5483f-36e1-4688-b7f5-ea07361b26a8
BLE_RX_CHAR_UUID=beb5483e-36e1-4688-b7f5-ea07361b26a8
BLE_MTU=500

# ── Storage ────────────────────────────────────────────────────────────
RECORDINGS_DIR=./data/recordings
FACE_DB_DIR=./data/faces

# ── Feature Flags ──────────────────────────────────────────────────────
# Set to "false" to disable specific features
ENABLE_SCENE_DESC=true
ENABLE_OCR=true
ENABLE_FACE_RECOG=true
ENABLE_NAV=true
